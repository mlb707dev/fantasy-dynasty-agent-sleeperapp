# Fantasy Dynasty Agent configuration
#
#   cp .env.example .env      # then fill in YOUR OWN values in .env
#
# .env is git-ignored. NEVER commit a real key. Every key below is a
# placeholder — each user of this project must supply their own.

# Sleeper: no API key needed. Sleeper's public API is read-only and keyless.
SLEEPER_LEAGUE_ID=your-sleeper-league-id
# Optional: your roster_id in that league (enables "my team" views)
SLEEPER_MY_ROSTER_ID=

# Anthropic API key — ONLY needed for the research agent (/v1/private/research).
# Get your own at https://console.anthropic.com/  → Settings → API Keys.
# Leave as the placeholder if you don't use the agent; everything else works.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Model used by the research agent
DYNASTY_AGENT_MODEL=claude-sonnet-5-5

# Bearer token that protects the PRIVATE API routes (/v1/private/*).
# Make up your own long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DYNASTY_AGENT_API_TOKEN=your-private-api-token-here

# Auction / keeper rules (defaults shown)
DYNASTY_AGENT_BUDGET=200
DYNASTY_AGENT_KEEPER_INFLATION=5
DYNASTY_AGENT_MAX_KEEPERS=2
